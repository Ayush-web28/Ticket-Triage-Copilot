# Get your key from https://tokenfactory.nebius.com/ (Token Factory dashboard -> API Keys)
NEBIUS_API_KEY=

# OpenAI-compatible Token Factory endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model tiers. Verify current slugs against https://tokenfactory.nebius.com/models/catalog
# before a real run -- catalog names change as new Nemotron 3 sizes roll out.
MODEL_NANO=nvidia/nemotron-3-nano-30b-a3b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
MODEL_EMBEDDING=BAAI/bge-en-icl

# When true (or when NEBIUS_API_KEY is empty), the pipeline uses deterministic
# rule-based stand-ins instead of calling Nebius, so the app runs end-to-end offline.
MOCK_MODE=false

DATABASE_URL=sqlite:///./triage.db
